syntax = "v1"

import "base.api"

// 输出任务信息
type OutputTaskInfo {
    BaseIDInfo
    
    // 基础信息
    Name        string `json:"name"`        // 任务名称
    Description string `json:"description"` // 任务描述
    OutputType  string `json:"outputType"`  // 输出类型: kafka, elasticsearch, database, api, file, webhook, email
    TaskStatus  string `json:"taskStatus"`  // 任务状态: pending, running, completed, failed, cancelled, paused
    Priority    int    `json:"priority"`    // 优先级
    
    // 超时配置
    TimeoutSeconds int `json:"timeoutSeconds"` // 超时时间(秒)
    
    // 数据源配置
    DataSource   string `json:"dataSource"`   // 数据源JSON
    OutputFormat string `json:"outputFormat"` // 输出格式: json, xml, csv, excel, txt, parquet, avro
    
    // 推送目标
    PushTargets       string `json:"pushTargets"`       // 推送目标JSON数组
    CompressionConfig string `json:"compressionConfig"` // 压缩配置JSON
    TransformConfig   string `json:"transformConfig"`   // 转换配置JSON
    
    // 调度信息
    ScheduledAt  *int64 `json:"scheduledAt,optional"`  // 计划执行时间
    StartedAt    *int64 `json:"startedAt,optional"`    // 开始执行时间
    CompletedAt  *int64 `json:"completedAt,optional"`  // 完成时间
    
    // 处理统计
    TotalRecords int64 `json:"totalRecords"` // 总记录数
    ProcessedRecords int64  `json:"processedRecords"` // 已处理记录数
    SuccessRecords   int64  `json:"successRecords"`   // 成功记录数
    FailedRecords    int64  `json:"failedRecords"`    // 失败记录数
    OutputFilePath   string `json:"outputFilePath"`   // 输出文件路径
    OutputFileSize   int64  `json:"outputFileSize"`   // 输出文件大小
    
    // 错误信息
    ErrorMessage *string `json:"errorMessage,optional"` // 错误消息
    ErrorDetails string  `json:"errorDetails"`          // 错误详情JSON
    
    // 重试配置
    MaxRetry    int    `json:"maxRetry"`              // 最大重试次数
    RetryCount  int    `json:"retryCount"`            // 已重试次数
    NextRetryAt *int64 `json:"nextRetryAt,optional"`  // 下次重试时间
    
    // 执行信息
    WorkerId         *string `json:"workerId,optional"`         // 执行工作节点ID
    ProgressPercent  int     `json:"progressPercent"`           // 进度百分比
    ProgressMessage  string  `json:"progressMessage"`           // 进度消息
    ThroughputRate   float64 `json:"throughputRate"`            // 吞吐率(记录/秒)
    DurationSeconds  int     `json:"durationSeconds"`           // 执行时长(秒)
    
    // 触发信息
    TriggerSource string  `json:"triggerSource"`          // 触发源
    TriggerTaskId *uint64 `json:"triggerTaskId,optional"` // 触发任务ID
    Dependencies  string  `json:"dependencies"`           // 依赖任务JSON数组
    
    // 扩展元数据
    Metadata string `json:"metadata"` // 扩展元数据JSON
}

// 输出任务列表响应
type OutputTaskListResp {
    BaseDataInfo
    Data OutputTaskListData `json:"data"`
}

type OutputTaskListData {
    BaseListInfo
    Data []OutputTaskInfo `json:"data"`
}

// 输出任务信息响应
type OutputTaskInfoResp {
    BaseDataInfo
    Data OutputTaskInfo `json:"data"`
}

// 创建输出任务请求
type CreateOutputTaskReq {
    Name              string  `json:"name"`                         // 任务名称
    Description       *string `json:"description,optional"`         // 任务描述
    OutputType        string  `json:"outputType"`                   // 输出类型
    Priority          *int    `json:"priority,optional"`            // 优先级
    TimeoutSeconds    *int    `json:"timeoutSeconds,optional"`      // 超时时间
    DataSource        *string `json:"dataSource,optional"`          // 数据源
    OutputFormat      *string `json:"outputFormat,optional"`        // 输出格式
    PushTargets       *string `json:"pushTargets,optional"`         // 推送目标
    CompressionConfig *string `json:"compressionConfig,optional"`   // 压缩配置
    TransformConfig   *string `json:"transformConfig,optional"`     // 转换配置
    ScheduledAt       *int64  `json:"scheduledAt,optional"`         // 计划执行时间
    MaxRetry          *int    `json:"maxRetry,optional"`            // 最大重试次数
    TriggerSource     *string `json:"triggerSource,optional"`       // 触发源
    TriggerTaskId     *uint64 `json:"triggerTaskId,optional"`       // 触发任务ID
    Dependencies      *string `json:"dependencies,optional"`        // 依赖任务
    Metadata          *string `json:"metadata,optional"`            // 扩展元数据
}

// 更新输出任务请求
type UpdateOutputTaskReq {
    Id                uint64  `json:"id"`                           // 任务ID
    Name              *string `json:"name,optional"`                // 任务名称
    Description       *string `json:"description,optional"`         // 任务描述
    OutputType        *string `json:"outputType,optional"`          // 输出类型
    Priority          *int    `json:"priority,optional"`            // 优先级
    TimeoutSeconds    *int    `json:"timeoutSeconds,optional"`      // 超时时间
    DataSource        *string `json:"dataSource,optional"`          // 数据源
    OutputFormat      *string `json:"outputFormat,optional"`        // 输出格式
    PushTargets       *string `json:"pushTargets,optional"`         // 推送目标
    CompressionConfig *string `json:"compressionConfig,optional"`   // 压缩配置
    TransformConfig   *string `json:"transformConfig,optional"`     // 转换配置
    ScheduledAt       *int64  `json:"scheduledAt,optional"`         // 计划执行时间
    MaxRetry          *int    `json:"maxRetry,optional"`            // 最大重试次数
    TriggerSource     *string `json:"triggerSource,optional"`       // 触发源
    TriggerTaskId     *uint64 `json:"triggerTaskId,optional"`       // 触发任务ID
    Dependencies      *string `json:"dependencies,optional"`        // 依赖任务
    Metadata          *string `json:"metadata,optional"`            // 扩展元数据
}

// 输出任务列表查询请求
type GetOutputTaskListReq {
    PageInfo
    
    Name       *string `form:"name,optional" json:"name,optional"`       // 名称过滤
    OutputType *string `form:"outputType,optional" json:"outputType,optional"` // 类型过滤
    TaskStatus *string `form:"taskStatus,optional" json:"taskStatus,optional"` // 状态过滤
}

@server(
    group: output_task
)
service Io {
    // 创建输出任务
    @handler createOutputTask
    post /output_task/create (CreateOutputTaskReq) returns (OutputTaskInfoResp)
    
    // 更新输出任务
    @handler updateOutputTask
    post /output_task/update (UpdateOutputTaskReq) returns (OutputTaskInfoResp)
    
    // 删除输出任务
    @handler deleteOutputTask
    post /output_task/delete (IDReq) returns (BaseMsgResp)
    
    // 获取输出任务详情
    @handler getOutputTask
    get /output_task/:id (IDPathReq) returns (OutputTaskInfoResp)
    
    // 获取输出任务列表
    @handler getOutputTaskList
    get /output_task/list (GetOutputTaskListReq) returns (OutputTaskListResp)
    
    // 启动输出任务
    @handler startOutputTask
    post /output_task/start (IDReq) returns (BaseMsgResp)
    
    // 暂停输出任务
    @handler pauseOutputTask
    post /output_task/pause (IDReq) returns (BaseMsgResp)
    
    // 取消输出任务
    @handler cancelOutputTask
    post /output_task/cancel (IDReq) returns (BaseMsgResp)
}
