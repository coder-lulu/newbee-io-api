syntax = "v1"

import "base.api"

// 输入任务信息
type InputTaskInfo {
    BaseIDInfo
    
    // 基础信息
    Name        string `json:"name"`        // 任务名称
    Description string `json:"description"` // 任务描述
    TaskType    string `json:"taskType"`    // 任务类型: file, api, sdk, builtin, manual
    TaskStatus  string `json:"taskStatus"`  // 任务状态: pending, running, completed, failed, cancelled, paused
    Priority    int    `json:"priority"`    // 优先级
    
    // 超时配置
    TimeoutSeconds int `json:"timeoutSeconds"` // 超时时间(秒)
    
    // 任务配置
    TaskConfig       string `json:"taskConfig"`       // 任务配置JSON
    ValidationConfig string `json:"validationConfig"` // 验证配置JSON
    OutputTargets    string `json:"outputTargets"`    // 输出目标JSON数组
    
    // 调度信息
    ScheduledAt  *int64 `json:"scheduledAt,optional"`  // 计划执行时间
    StartedAt    *int64 `json:"startedAt,optional"`    // 开始执行时间
    CompletedAt  *int64 `json:"completedAt,optional"`  // 完成时间
    
    // 处理统计
    ProcessedRecords int64 `json:"processedRecords"` // 已处理记录数
    SuccessRecords   int64 `json:"successRecords"`   // 成功记录数
    FailedRecords    int64 `json:"failedRecords"`    // 失败记录数
    
    // 错误信息
    ErrorMessage *string `json:"errorMessage,optional"` // 错误消息
    ErrorDetails string  `json:"errorDetails"`          // 错误详情JSON
    
    // 重试配置
    MaxRetry    int    `json:"maxRetry"`              // 最大重试次数
    RetryCount  int    `json:"retryCount"`            // 已重试次数
    NextRetryAt *int64 `json:"nextRetryAt,optional"`  // 下次重试时间
    
    // 导入模式配置
    ImportMode       string `json:"importMode"`       // 导入模式: create_only, update_only, upsert, merge
    ConflictStrategy string `json:"conflictStrategy"` // 冲突策略: skip, overwrite, merge, error
    UniqueKeys       string `json:"uniqueKeys"`       // 唯一键字段列表JSON
    
    // 审核流程
    ApprovalStatus  string  `json:"approvalStatus"`           // 审核状态: pending, approved, rejected
    ApprovedBy      *uint64 `json:"approvedBy,optional"`      // 审核人ID
    ApprovedAt      *int64  `json:"approvedAt,optional"`      // 审核时间
    RejectionReason *string `json:"rejectionReason,optional"` // 拒绝原因
    
    // 关联信息
    DiscoveryPoolId *uint64 `json:"discoveryPoolId,optional"` // 关联发现池ID
    WorkerId        *string `json:"workerId,optional"`        // 执行工作节点ID
    
    // 进度信息
    ProgressPercent int    `json:"progressPercent"`  // 进度百分比
    ProgressMessage string `json:"progressMessage"`  // 进度消息
    
    // 扩展元数据
    Metadata string `json:"metadata"` // 扩展元数据JSON
}

// 输入任务列表响应
type InputTaskListResp {
    BaseDataInfo
    Data InputTaskListData `json:"data"`
}

type InputTaskListData {
    BaseListInfo
    Data []InputTaskInfo `json:"data"`
}

// 输入任务信息响应
type InputTaskInfoResp {
    BaseDataInfo
    Data InputTaskInfo `json:"data"`
}

// 创建输入任务请求
type CreateInputTaskReq {
    Name             string  `json:"name"`                        // 任务名称
    Description      *string `json:"description,optional"`        // 任务描述
    TaskType         string  `json:"taskType"`                    // 任务类型
    Priority         *int    `json:"priority,optional"`           // 优先级
    TimeoutSeconds   *int    `json:"timeoutSeconds,optional"`     // 超时时间
    TaskConfig       *string `json:"taskConfig,optional"`         // 任务配置
    ValidationConfig *string `json:"validationConfig,optional"`   // 验证配置
    OutputTargets    *string `json:"outputTargets,optional"`      // 输出目标
    ScheduledAt      *int64  `json:"scheduledAt,optional"`        // 计划执行时间
    MaxRetry         *int    `json:"maxRetry,optional"`           // 最大重试次数
    ImportMode       *string `json:"importMode,optional"`         // 导入模式
    ConflictStrategy *string `json:"conflictStrategy,optional"`   // 冲突策略
    UniqueKeys       *string `json:"uniqueKeys,optional"`         // 唯一键列表JSON
    DiscoveryPoolId  *uint64 `json:"discoveryPoolId,optional"`    // 关联发现池ID
    Metadata         *string `json:"metadata,optional"`           // 扩展元数据
}

// 更新输入任务请求
type UpdateInputTaskReq {
    Id               uint64  `json:"id"`                          // 任务ID
    Name             *string `json:"name,optional"`               // 任务名称
    Description      *string `json:"description,optional"`        // 任务描述
    TaskType         *string `json:"taskType,optional"`           // 任务类型
    Priority         *int    `json:"priority,optional"`           // 优先级
    TimeoutSeconds   *int    `json:"timeoutSeconds,optional"`     // 超时时间
    TaskConfig       *string `json:"taskConfig,optional"`         // 任务配置
    ValidationConfig *string `json:"validationConfig,optional"`   // 验证配置
    OutputTargets    *string `json:"outputTargets,optional"`      // 输出目标
    ScheduledAt      *int64  `json:"scheduledAt,optional"`        // 计划执行时间
    MaxRetry         *int    `json:"maxRetry,optional"`           // 最大重试次数
    DiscoveryPoolId  *uint64 `json:"discoveryPoolId,optional"`    // 关联发现池ID
    Metadata         *string `json:"metadata,optional"`           // 扩展元数据
}

// 输入任务列表查询请求
type GetInputTaskListReq {
    PageInfo
    
    Name            *string `json:"name,optional"`            // 名称过滤
    TaskType        *string `json:"taskType,optional"`        // 类型过滤
    TaskStatus      *string `json:"taskStatus,optional"`      // 状态过滤
    ApprovalStatus  *string `json:"approvalStatus,optional"`  // 审核状态过滤
    DiscoveryPoolId *uint64 `json:"discoveryPoolId,optional"` // 发现池过滤
}

// 审核输入任务请求
type ApproveInputTaskReq {
    Id     uint64  `json:"id"`                       // 任务ID
    Action string  `json:"action"`                   // 审核动作: approve, reject
    Reason *string `json:"reason,optional"`          // 拒绝原因(拒绝时必填)
}

@server(
    group: input_task
)
service Io {
    // 创建输入任务
    @handler createInputTask
    post /input_task/create (CreateInputTaskReq) returns (InputTaskInfoResp)
    
    // 更新输入任务
    @handler updateInputTask
    post /input_task/update (UpdateInputTaskReq) returns (InputTaskInfoResp)
    
    // 删除输入任务
    @handler deleteInputTask
    post /input_task/delete (IDReq) returns (BaseMsgResp)
    
    // 获取输入任务详情
    @handler getInputTask
    get /input_task/:id (IDPathReq) returns (InputTaskInfoResp)
    
    // 获取输入任务列表
    @handler getInputTaskList
    post /input_task/list (GetInputTaskListReq) returns (InputTaskListResp)
    
    // 启动输入任务
    @handler startInputTask
    post /input_task/start (IDReq) returns (BaseMsgResp)
    
    // 暂停输入任务
    @handler pauseInputTask
    post /input_task/pause (IDReq) returns (BaseMsgResp)
    
    // 取消输入任务
    @handler cancelInputTask
    post /input_task/cancel (IDReq) returns (BaseMsgResp)
    
    // 审核输入任务
    @handler approveInputTask
    post /input_task/approve (ApproveInputTaskReq) returns (BaseMsgResp)
}
